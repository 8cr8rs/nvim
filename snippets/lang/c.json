{
  "Algorithm Min": {
    "prefix": "algmin",
    "body": [
      "int ${1:min}1 = INT_MAX;",
      "int ${1:min}2 = INT_MAX;",
      "int ${1:min}3 = INT_MAX;",
      "",
      "for (int ${2:i} = 0; ${2:i} < {3:length}; ${2:i}++) {",
      "\tint ${4:x} = list[${2:i}];",
      "\tif (${4:x} < ${1:min}1) {",
      "\t\t${1:min}3 = ${1:min}2;",
      "\t\t${1:min}2 = ${1:min}1;",
      "\t\t${1:min}1 = ${4:x};",
      "\t} else if (${4:x} < ${1:min}2) {",
      "\t\t${1:min}3 = ${1:min}2;",
      "\t\t${1:min}2 = ${4:x};",
      "\t} else if (${4:x} < ${1:min}3) {",
      "\t\t${1:min}3 = ${4:x};",
      "\t}",
      "}"
    ],
    "description": "Expandable minimum algorithm"
  }
}
